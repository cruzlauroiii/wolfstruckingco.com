@page "/Buy/Notes"

<div class="Stage PageStage">
    <h1>Special instructions</h1>
    <p>Step 5 of 5 — any extra requests for the driver.</p>
    <div class="Step5"><div class="Bar D"></div><div class="Bar D"></div><div class="Bar D"></div><div class="Bar D"></div><div class="Bar D"></div></div>

    <div class="Card CardForm">
        <div class="CheckList">
            <label><input type="checkbox" @bind="PhotoProof" /> Photo proof of delivery required</label>
            <label><input type="checkbox" @bind="PhotoId" /> Photo ID check at door</label>
            <label><input type="checkbox" @bind="Driveway" /> Park in driveway, do not block street</label>
            <label><input type="checkbox" @bind="CallAhead" /> Call 15 minutes before arrival</label>
            <label><input type="checkbox" @bind="CargoInsurance" /> Add cargo insurance ($150)</label>
        </div>
        <div class="Field FieldGap"><label>Note for the driver</label><textarea rows="3" @bind="DriverNote"></textarea></div>
        <button class="Btn Block" type="button" @onclick="ConfirmOrderAsync">@ConfirmLabel</button>
        @if (!string.IsNullOrEmpty(StatusMessage))
        {
            <p class="FieldGap">@StatusMessage</p>
        }
    </div>
</div>
